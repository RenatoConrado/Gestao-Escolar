# TLS interno (CA local do Caddy) para uso na rede da escola. SIGE_HOST = nome ou IP que os clientes usam.
{
	local_certs
}

{$SIGE_HOST:sige.local} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	# Rotas da API Spring Boot
	handle /api/* {
		reverse_proxy api:8080
	}

	handle /actuator/* {
		reverse_proxy api:8080
	}

	handle /swagger-ui* {
		reverse_proxy api:8080
	}

	handle /v3/api-docs* {
		reverse_proxy api:8080
	}

	# Frontend Next.js (Dashboard, SPA e SSR)
	handle {
		reverse_proxy frontend:3000
	}
}
